# Credenciais. Nunca publique o arquivo .env real.
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Modelo de visao configuravel. Mantenha um modelo que aceite imagens na sua conta.
ANTHROPIC_MODEL=claude-sonnet-5

# Janela operacional e intervalo de analise.
ANALISE_INTERVALO_MIN=5
HORARIO_INICIO=09:05
HORARIO_FIM=17:25

# ENTRADA,QUASE ou ENTRADA apenas.
ENVIAR_TELEGRAM_PARA=ENTRADA,QUASE

# Limite operacional. O sistema calcula risco de 1 a 5 contratos.
MAX_CONTRATOS=5
RISCO_MAXIMO_BRL=

# Opcional: x1,y1,x2,y2. Vazio captura a tela inteira.
REGIAO_CAPTURA=
